<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ product.name }} | Product details</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container py-5">
    <div class="row align-items-center">

        <!-- Product image -->
        <div class="col-lg-6 mb-4 mb-lg-0">
            <img
                src="{{ product.image }}"
                alt="{{ product.name }}"
                class="img-fluid rounded shadow-sm"
            >
        </div>

        <!-- Product info -->
        <div class="col-lg-6">
            <h2 class="fw-bold mb-3">{{ product.name }}</h2>

            <div class="fs-3 text-secondary mb-4">
                {{ product.price }} $
            </div>

            <p class="mb-4 text-muted">
                Enjoy high-quality audio with these premium wireless headphones.
                Designed for comfort, long battery life, and immersive sound.
            </p>

            <div class="mb-4">
                <p><strong>Brand:</strong> {{ product.brand }}</p>
                <p><strong>Available color:</strong> {{ product.color }}</p>
                <p><strong>Connection:</strong> {{ product.connectivity }}</p>
                <p><strong>Battery:</strong> {{ product.battery }}</p>
            </div>

            <!-- Add to cart form -->
            {{ form_start(form) }}

                <div class="row mb-3">
                    <div class="col-4">
                        {{ form_label(form.quantity) }}
                        {{ form_widget(form.quantity) }}
                    </div>
                </div>

                <div class="mb-4">
                    {{ form_label(form.color) }}
                    {{ form_widget(form.color) }}
                </div>

                {{ form_widget(form.submit) }}

            {{ form_end(form) }}
        </div>

    </div>
</div>

</body>
</html>

